{
  "expo": {
    "name": "Thattu Kaasu",
    "slug": "ThattuKaasu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf9f6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ram_kirsh.thattukaasu"
    },
    "android": {
      "package": "com.ram_kirsh.thattukaasu",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/Logo.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Thattu Kaasu to use Face ID for securing your data."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b9791f54-b2ac-4571-9904-53a10dbfe4c8"
      }
    },
    "owner": "ram_kirsh"
  }
}
